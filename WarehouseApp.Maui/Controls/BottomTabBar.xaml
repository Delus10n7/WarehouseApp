<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WarehouseApp.Maui.Controls.BottomTabBar"
             x:Name="root">

    <Border BackgroundColor="#CCFFFFFF"
            StrokeThickness="0"
            Margin="16,0,16,16"
            Padding="0,10"
            HeightRequest="90">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.25" />
        </Border.Shadow>

        <Grid ColumnDefinitions="*,*,*,*">

            <!-- Отчёты -->
            <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        Command="{Binding Source={x:Reference root}, Path=OnTabTappedCommand}"
                        CommandParameter="reports"
                        PressedScale="0.92"
                        PressedOpacity="0.6"
                        PressedAnimationDuration="60"
                        DefaultAnimationDuration="60"/>
                </Border.Behaviors>

                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="&#xf080;" 
                           FontFamily="FontAwesomeSolid" 
                           FontSize="34"
                           HorizontalOptions="Center" 
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="reports">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Отчёты" FontSize="13" HorizontalOptions="Center" TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="reports">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Документы -->
            <Border Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        Command="{Binding Source={x:Reference root}, Path=OnTabTappedCommand}"
                        CommandParameter="documents"
                        PressedScale="0.92"
                        PressedOpacity="0.6"
                        PressedAnimationDuration="60"
                        DefaultAnimationDuration="60" />
                </Border.Behaviors>

                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="&#xf15c;"
                           FontFamily="FontAwesomeSolid"
                           FontSize="34"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="documents">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Документы"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="documents">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Товары -->
            <Border Grid.Column="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        Command="{Binding Source={x:Reference root}, Path=OnTabTappedCommand}"
                        CommandParameter="products"
                        PressedScale="0.92"
                        PressedOpacity="0.6"
                        PressedAnimationDuration="60"
                        DefaultAnimationDuration="60" />
                </Border.Behaviors>

                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="&#xf290;"
                           FontFamily="FontAwesomeSolid"
                           FontSize="34"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="products">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Товары"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="products">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Контрагенты -->
            <Border Grid.Column="3"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        Command="{Binding Source={x:Reference root}, Path=OnTabTappedCommand}"
                        CommandParameter="counterparties"
                        PressedScale="0.92"
                        PressedOpacity="0.6"
                        PressedAnimationDuration="60"
                        DefaultAnimationDuration="60" />
                </Border.Behaviors>

                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="&#xf0c0;"
                           FontFamily="FontAwesomeSolid"
                           FontSize="34"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="counterparties">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Контрагенты"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#8E8E93">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding ActiveTab, Source={x:Reference root}}"
                                         Value="counterparties">
                                <Setter Property="TextColor" Value="#2E7CF6" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Border>
</ContentView>
