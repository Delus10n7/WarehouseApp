<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="WarehouseApp.Maui.Views.Documents.DocumentPopup"
               BackgroundColor="Transparent">

  <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="24" Margin="20,0" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="340">
    <Border.StrokeShape>
      <RoundRectangle CornerRadius="16" />
    </Border.StrokeShape>
    <Border.Shadow>
      <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.25" />
    </Border.Shadow>

    <VerticalStackLayout Spacing="14">
      <!-- Заголовок -->
      <Grid ColumnDefinitions="*, Auto">
        <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        <Label Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="20" TextColor="{StaticResource TextPrimary}">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCloseTapped" />
          </Label.GestureRecognizers>
        </Label>
      </Grid>

      <!-- Переключатель типа (скрыт при редактировании) -->
      <Border StrokeThickness="1" Stroke="{StaticResource Primary}" Padding="2">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>
        <Border.Triggers>
          <DataTrigger TargetType="Border" Binding="{Binding IsEditMode}" Value="True">
            <Setter Property="IsVisible" Value="False" />
          </DataTrigger>
        </Border.Triggers>

        <Grid ColumnDefinitions="*, *">
          <!-- Кнопка "Поступление" -->
          <Button Text="Поступление" CornerRadius="20" HeightRequest="36" 
                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                            Command="{Binding ToggleTypeCommand}" CommandParameter="Receipt">
            <Button.Triggers>
              <DataTrigger TargetType="Button" Binding="{Binding IsReceipt}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
              </DataTrigger>
            </Button.Triggers>
          </Button>

          <!-- Кнопка "Продажа" -->
          <Button Grid.Column="1" Text="Продажа" CornerRadius="20" HeightRequest="36" 
                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                            Command="{Binding ToggleTypeCommand}" CommandParameter="Sale">
            <Button.Triggers>
              <DataTrigger TargetType="Button" Binding="{Binding IsReceipt}" Value="False">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
              </DataTrigger>
            </Button.Triggers>
          </Button>
        </Grid>
      </Border>

      <!-- Товар -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="Товар" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Picker ItemsSource="{Binding Products}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProduct}" Title="Выберите товар" TextColor="{StaticResource TextPrimary}" />
        </Border>
      </VerticalStackLayout>

      <!-- Контрагент -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="{Binding CounterpartyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Picker ItemsSource="{Binding Counterparties}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCounterparty}" Title="Выберите контрагента" TextColor="{StaticResource TextPrimary}" />
        </Border>
      </VerticalStackLayout>

      <!-- Количество -->
      <VerticalStackLayout Spacing="4">
        <Label Text="{Binding QuantityLabel}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Entry Text="{Binding QuantityText}" Placeholder="Введите количество..." Keyboard="Numeric" PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" HeightRequest="44"/>
        </Border>
      </VerticalStackLayout>

      <!-- Сумма -->
      <VerticalStackLayout Spacing="4">
        <Label Text="Сумма" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Entry Text="{Binding AmountText}" Placeholder="Введите сумму..." Keyboard="Numeric" PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" HeightRequest="44"/>
        </Border>
      </VerticalStackLayout>

      <!-- Ошибка -->
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" IsVisible="{Binding HasError}" Margin="0,-4,0,0" />

      <!-- Кнопка -->
      <Button Text="{Binding ButtonText}" BackgroundColor="{Binding ButtonColor}" Command="{Binding SaveCommand}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,8,0,0"/>
    </VerticalStackLayout>
  </Border>
</toolkit:Popup>