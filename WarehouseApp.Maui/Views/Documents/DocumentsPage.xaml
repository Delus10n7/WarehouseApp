<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WarehouseApp.Maui.Controls"
    x:Class="WarehouseApp.Maui.Views.Documents.DocumentsPage"
    BackgroundColor="{StaticResource Surface}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,20">
                <Label Text="Документы"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomTabBar Grid.Row="1" ActiveTab="documents" />
    </Grid>
</ContentPage>