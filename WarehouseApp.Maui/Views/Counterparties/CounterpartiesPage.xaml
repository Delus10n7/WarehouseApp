<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WarehouseApp.Maui.Controls"
    x:Class="WarehouseApp.Maui.Views.Counterparties.CounterpartiesPage"
    BackgroundColor="{StaticResource Surface}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Шапка с заголовком и кнопкой добавления -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,20,12">
            <Label Text="Контрагенты" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}" 
                   VerticalOptions="Center"/>

            <Button Grid.Column="1" 
                    Text="+" 
                    FontSize="24" 
                    WidthRequest="44" 
                    HeightRequest="44" 
                    CornerRadius="22" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    Padding="0" 
                    VerticalOptions="Center"
                    Clicked="OnAddCounterpartyClicked"/>
        </Grid>

        <!-- Строка поиска -->
        <Border Grid.Row="1" 
                Margin="20,0,20,16" 
                BackgroundColor="{StaticResource BackgroundColor}" 
                StrokeThickness="0" 
                Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.05" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *">
                <Label Text="&#xf002;" 
                       FontFamily="FontAwesomeSolid" 
                       FontSize="16"
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center" 
                       Margin="0,0,10,0"/>
                <Entry Grid.Column="1" 
                       Placeholder="Поиск по названию..." 
                       PlaceholderColor="{StaticResource TextSecondary}" 
                       TextColor="{StaticResource TextPrimary}" 
                       BackgroundColor="Transparent"
                       HeightRequest="44"/>
            </Grid>
        </Border>

        <!-- CollectionView -->
        <VerticalStackLayout Grid.Row="2" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Center" 
                             Spacing="12" 
                             Padding="40">
            <Label Text="&#xf0c0;" 
                   FontFamily="FontAwesomeSolid" 
                   FontSize="64" 
                   TextColor="{StaticResource TextDisabled}" 
                   HorizontalOptions="Center"/>
            <Label Text="У вас пока нет контрагентов" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>
            <Label Text="Нажмите на кнопку «+», чтобы создать первого контрагента в вашем списке." 
                   FontSize="14" 
                   TextColor="{StaticResource TextSecondary}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Таб бар -->
        <controls:BottomTabBar Grid.Row="3" ActiveTab="counterparties" />

    </Grid>
</ContentPage>