<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WarehouseApp.Maui.Controls"
    xmlns:vm="clr-namespace:WarehouseApp.Maui.ViewModels.Counterparties"
    xmlns:domain="clr-namespace:WarehouseApp.Domain.Entities;assembly=WarehouseApp.Domain"
    x:Class="WarehouseApp.Maui.Views.Counterparties.CounterpartiesPage"
    x:DataType="vm:CounterpartiesViewModel"
    BackgroundColor="{StaticResource Surface}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,20,12">
            <Label Text="Контрагенты" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="+" FontSize="24" WidthRequest="44" HeightRequest="44" CornerRadius="22" 
                    BackgroundColor="{StaticResource Primary}" TextColor="White" Padding="0" VerticalOptions="Center"
                    Clicked="OnAddCounterpartyClicked"/>
        </Grid>

        <!-- Поиск -->
        <Border Grid.Row="1" Margin="20,0,20,16" BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *">
                <Label Text="&#xf002;" FontFamily="FontAwesomeSolid" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Поиск по названию..." 
                       PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" 
                       BackgroundColor="Transparent" HeightRequest="44"/>
            </Grid>
        </Border>

        <!-- Список с обновлением -->
        <RefreshView Grid.Row="2" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}" Margin="0,0,0,10">
            <CollectionView ItemsSource="{Binding Counterparties}" SelectionMode="None">

                <!-- Заглушка, если список пуст -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="40">
                        <Label Text="У вас пока нет контрагентов" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label Text="Нажмите на кнопку «+», чтобы создать первого контрагента в вашем списке." FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Карточка контрагента -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Counterparty">
                        <Grid Padding="10,8">
                            <Border BackgroundColor="{StaticResource Surface}" 
                                    StrokeThickness="0"
                                    Margin="10,0"
                                    Padding="20,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference page}, Path=BindingContext.EditCommand}" 
                                                  CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Name}" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Start"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Таб бар -->
        <controls:BottomTabBar Grid.Row="3" ActiveTab="counterparties" />

    </Grid>
</ContentPage>