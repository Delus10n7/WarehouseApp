    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WarehouseApp.Maui.Controls"
    x:Class="WarehouseApp.Maui.Views.Counterparties.CounterpartiesPage"
    BackgroundColor="#F5F5F7"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,20">
                <Label Text="Контрагенты"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="Black" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomTabBar Grid.Row="1" ActiveTab="counterparties" />
    </Grid>
</ContentPage>