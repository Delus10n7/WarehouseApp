<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="WarehouseApp.Maui.Views.Counterparties.CounterpartyPopup"
               BackgroundColor="Transparent">

    <Border BackgroundColor="{StaticResource Surface}"
            StrokeThickness="0"
            Padding="24"
            Margin="20,0"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="340">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.25" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- Заголовок и кнопка закрытия -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                <Label Text="{Binding Title}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center"/>

                <Label Grid.Column="1" 
                       Text="&#xf00d;" 
                       FontFamily="FontAwesomeSolid" 
                       FontSize="20" 
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Наименование -->
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Наименование" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                </HorizontalStackLayout>
                <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Name}" 
                           Placeholder="Введите наименование контрагента..." 
                           PlaceholderColor="{StaticResource TextSecondary}" 
                           TextColor="{StaticResource TextPrimary}" 
                           BackgroundColor="Transparent"
                           HeightRequest="44"/>
                </Border>
            </VerticalStackLayout>

            <!-- Телефон -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Телефон" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Phone}" 
                           Placeholder="Введите телефон контрагента..." 
                           PlaceholderColor="{StaticResource TextSecondary}" 
                           TextColor="{StaticResource TextPrimary}" 
                           Keyboard="Telephone"
                           BackgroundColor="Transparent"
                           HeightRequest="44"/>
                </Border>
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Email" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Email}" 
                           Placeholder="Введите email контрагента..." 
                           PlaceholderColor="{StaticResource TextSecondary}" 
                           TextColor="{StaticResource TextPrimary}" 
                           Keyboard="Email"
                           BackgroundColor="Transparent"
                           HeightRequest="44"/>
                </Border>
            </VerticalStackLayout>

            <!-- Сообщение об ошибке -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="{StaticResource Danger}" 
                   FontSize="12" 
                   IsVisible="{Binding HasError}" 
                   Margin="0,-8,0,0" />
            
            <!-- Кнопка сохранения -->
            <Button Text="{Binding ButtonText}" 
                    BackgroundColor="{Binding ButtonColor}" 
                    Command="{Binding SaveCommand}"
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
