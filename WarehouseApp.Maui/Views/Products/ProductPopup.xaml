<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="WarehouseApp.Maui.Views.Products.ProductPopup"
               BackgroundColor="Transparent">

  <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="24" Margin="20,0" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="340">
    <Border.StrokeShape>
      <RoundRectangle CornerRadius="16" />
    </Border.StrokeShape>
    <Border.Shadow>
      <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.25" />
    </Border.Shadow>

    <VerticalStackLayout Spacing="14">
      <!-- Заголовок -->
      <Grid ColumnDefinitions="*, Auto">
        <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
        <Label Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="20" TextColor="{StaticResource TextPrimary}">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCloseTapped" />
          </Label.GestureRecognizers>
        </Label>
      </Grid>

      <!-- Название -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="Название товара" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Entry Text="{Binding Name}" Placeholder="Введите название товара..." PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" HeightRequest="44"/>
        </Border>
      </VerticalStackLayout>

      <!-- Артикул -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="Артикул" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Entry Text="{Binding Article}" Placeholder="Введите артикул товара..." PlaceholderColor="{StaticResource TextSecondary}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" HeightRequest="44"/>
        </Border>
      </VerticalStackLayout>

      <!-- Категория -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="Категория товара" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Picker ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}" Title="Выберите категорию" TextColor="{StaticResource TextPrimary}" />
        </Border>
        <!-- Кнопка добавления -->
        <Button Text="+ Добавить новую категорию" Command="{Binding AddNewCategoryCommand}" 
            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" 
            HorizontalOptions="End" Padding="0" Margin="0,2,0,0"/>
      </VerticalStackLayout>

      <!-- Единица измерения -->
      <VerticalStackLayout Spacing="4">
        <HorizontalStackLayout Spacing="4">
          <Label Text="Единица измерения" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
          <Label Text="*" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
        </HorizontalStackLayout>
        <Border BackgroundColor="{StaticResource BackgroundColor}" StrokeThickness="0" Padding="12,0">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Picker ItemsSource="{Binding Units}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedUnit}" Title="Выберите единицу" TextColor="{StaticResource TextPrimary}" />
        </Border>
        <!-- Кнопка добавления -->
        <Button Text="+ Добавить новую единицу измерения" Command="{Binding AddNewUnitCommand}" 
            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" 
            HorizontalOptions="End" Padding="0" Margin="0,2,0,0"/>
      </VerticalStackLayout>

      <!-- Ошибка -->
      <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="12" IsVisible="{Binding HasError}" Margin="0,-4,0,0" />

      <!-- Кнопка -->
      <Button Text="{Binding ButtonText}" BackgroundColor="{Binding ButtonColor}" Command="{Binding SaveCommand}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,8,0,0"/>
    </VerticalStackLayout>
  </Border>
</toolkit:Popup>